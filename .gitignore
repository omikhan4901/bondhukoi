# ============================================================
# BondhuKoi — Monorepo .gitignore
# Covers: Node.js/Fastify backend + React Native/Expo frontend
# ============================================================


# ─── Environment & Secrets ───────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# Keep example files — they're safe to commit
!.env.example
!.env.example.*

# Google Auth credentials (contains client secrets)
**/Google Auth Creds.json
**/google-services.json
**/GoogleService-Info.plist


# ─── Node Modules ────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js


# ─── Package Manager Locks ───────────────────────────────────
# Commit package-lock.json or yarn.lock — but not both.
# Uncomment the one you don't use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml


# ─── Build Outputs ───────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/


# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ─── Runtime & Temp ──────────────────────────────────────────
tmp/
temp/
.tmp/
*.tmp
*.temp
backend/tmp/


# ─── OS Files ────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~


# ─── Editor & IDE ────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/


# ─── Expo / React Native ─────────────────────────────────────
# Expo metadata (safe to ignore — regenerated on `expo start`)
.expo/
.expo-shared/

# Expo build artifacts
frontend/BondhuKoiApp/dist/
frontend/BondhuKoiApp/.output/

# Native build folders (generated by `expo run:android` / `expo run:ios`)
# Commit these only if you want to manage native code manually.
# For managed Expo workflow, ignore them:
frontend/BondhuKoiApp/android/
frontend/BondhuKoiApp/ios/

# Metro bundler cache
.metro-cache/
frontend/BondhuKoiApp/.metro-cache/

# React Native
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Hermes bytecode
*.hbc

# EAS Build
.eas/


# ─── Tamagui ────────────────────────────────────────────────
.tamagui/


# ─── Testing & Coverage ──────────────────────────────────────
coverage/
*.lcov
.nyc_output/
junit.xml


# ─── Miscellaneous ───────────────────────────────────────────
# Scratch / debug scripts committed to the repo root
backend/check-all-users.js
backend/check-friends.js
backend/test-getfriends.js
backend/test-login.sh
frontend/BondhuKoiApp/test-exports.js

# Leftover brace file (artifact from a bad paste)
backend/[{]

# Old app.json backup (contains hardcoded API keys)
frontend/BondhuKoiApp/app.json.bak

enable_RLS.sql

demo.gif
*.gif
