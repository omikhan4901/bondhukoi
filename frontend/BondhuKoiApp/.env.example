# Copy to .env and fill in. Everything here ends up inside the app, so only public values:
# never put the Supabase service role key or a database URL here.

# The BondhuKoi API (Cloud Run URL in production, your machine's LAN IP in development)
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# Supabase project URL and its public anon key (Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Google Maps key for Android, restricted to the app's package name and signing certificate
GOOGLE_MAPS_API_KEY=your_restricted_maps_key
