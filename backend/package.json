{
  "name": "bondhukoi-api",
  "version": "2.0.0",
  "description": "BondhuKoi API: see which friends are on campus without anyone seeing where you are",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:test": "node scripts/test-db.mjs",
    "test": "node scripts/test-db.mjs && node --test --test-concurrency=1 'test/**/*.test.js'",
    "test:only": "node --test --test-concurrency=1 'test/**/*.test.js'",
    "lint": "eslint ."
  },
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@sentry/node": "^11.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3"
  }
}
