# Copy to .env for local development. In production these are Cloud Run secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres connection. Supabase: Settings > Database > Connection string > "Transaction pooler".
DATABASE_URL=<transaction pooler connection string from the Supabase dashboard>
DATABASE_SSL=true

# Supabase project URL and service role key (Settings > API). Server only: never in the app.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Only for projects still on the legacy JWT secret (Settings > API > JWT secret).
# Leave empty to verify tokens with the project's signing keys (recommended).
SUPABASE_JWT_SECRET=

# Browser origins allowed to call the API (the admin console). The mobile app needs none.
CORS_ORIGINS=http://localhost:5173

# Optional: Expo access token if "enhanced push security" is on in the Expo dashboard.
EXPO_ACCESS_TOKEN=

# Optional: daily admin alert emails. ALERTS_SECRET is a random 32+ character string, also
# stored as the GitHub secret ALERTS_SECRET; RESEND_API_KEY from resend.com (free tier).
ALERTS_SECRET=
RESEND_API_KEY=
ALERT_EMAIL=you@example.com
ALERT_FROM=BondhuKoi <alerts@your-verified-domain>
